# Copy to .env (which git ignores) and fill in. See README "Google Calendar setup".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/oauth/callback

# AI assistant (free Gemini key from https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Optional: a different model, e.g. gemini/gemini-2.5-flash-lite
# BYLLM_DEFAULT_MODEL=
